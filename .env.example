# Copy this file to `.env` (same folder) and fill in your own LLM key.
# `.env` is gitignored -- never commit it, it holds your API key.
# Full explanation of every setting: docs/en/CONFIGURATION.md

# ---------------------------------------------------------------------------
# Database (the defaults match db/docker-compose.yml -- local dev only, not a secret)
# ---------------------------------------------------------------------------
DB_DSN=postgresql://capstone:capstone@localhost:15432/capstone

# Embedding model used for semantic search. Must stay the model the seed
# embeddings were built with (768-dim). Downloaded automatically on first start (~550MB).
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# LLM -- any OpenAI-compatible chat-completions endpoint works.
# Pick ONE block below, uncomment it, and paste your key. Nothing else changes.
# ---------------------------------------------------------------------------

# DeepSeek (what the project was developed and evaluated with)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# OpenAI
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=

# Alibaba Qwen (DashScope, international endpoint)
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenRouter (one key, many models)
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Local model via Ollama (free, no key; quality depends on the model)
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Investment assumptions (optional -- leave empty to use the defaults shown).
# Every number computed from these is labelled "assumption" in the UI, and users
# can also change them live in the property detail panel.
# ---------------------------------------------------------------------------
# Operating expenses as a share of annual rent (industry range 0.25-0.30). Default 0.28
OPEX_RATE=
# Acquisition costs other than stamp duty, in AUD (conveyancing, inspection). Default 2000
OTHER_ACQUISITION_COSTS=
